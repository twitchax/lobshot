// Neonbay: a harbour city at night, its towers lit and its signs buzzing. Hand-written;
// `cargo xtask art` copies it to assets/gen with each variant's size and mask hash filled in.
//
// Spawns are columns, mirrored about the middle (x = 1000) so neither side starts with the better
// roof: four on the west roofs, four on the east. Every gap between buildings drops past the
// bottom of the map, so a mobile that walks or is knocked off a roof is lost. `cargo xtask art`
// refuses any spawn that leaves a mobile hanging off an edge or under an overhang.
MapInfo(
    name: "neonbay",
    title: "Neonbay",
    variants: [
        // Downtown: towers with stepped crowns at the edges, a hotel, a glass tower and a walk-up a
        // side, and a picture palace on the avenue in the middle.
        (id: "A", spawns: [140, 380, 620, 820, 1180, 1380, 1620, 1860]),
        // Docks: warehouses at the edges, a container stack and a cold store a side, the harbour
        // offices across the slip, and a crane's two boxes hung over it.
        (id: "B", spawns: [130, 420, 640, 840, 1160, 1360, 1580, 1870]),
    ],
)
