                Rock((1098.0, 666.7), (1098.0, 663.3), (1098.0, 660.0)),
            ],
            rough: 0.1,
        ),
        // Ice house: the mirror of the cold store (spawn 1360).
        (
            start: (1258.0, 500.0),
            edges: [
                Top((1292.0, 500.0), (1326.0, 500.0), (1360.0, 500.0)),
                Top((1394.0, 500.0), (1428.0, 500.0), (1462.0, 500.0)),
                Rock((1462.0, 503.3), (1462.0, 506.7), (1462.0, 510.0)),
                Rock((1458.7, 510.7), (1455.3, 511.3), (1452.0, 512.0)),
                Rock((1452.0, 721.3), (1452.0, 930.7), (1452.0, 1140.0)),
                Rock((1390.7, 1140.0), (1329.3, 1140.0), (1268.0, 1140.0)),
                Rock((1268.0, 930.7), (1268.0, 721.3), (1268.0, 512.0)),
                Rock((1264.7, 511.3), (1261.3, 510.7), (1258.0, 510.0)),
                Rock((1258.0, 506.7), (1258.0, 503.3), (1258.0, 500.0)),
            ],
            rough: 0.1,
        ),
        // The east stack (spawn 1580).
        (
            start: (1500.0, 420.0),
            edges: [
                Top((1553.3, 420.0), (1606.7, 420.0), (1660.0, 420.0)),
                Rock((1660.0, 660.0), (1660.0, 900.0), (1660.0, 1140.0)),
