// Neonbay B, "docks": the land, the one source for both the terrain art and the collision mask.
//
// World pixels, y down. Each block is a closed chain of cubic Béziers (here straight lines: two
// control points at the thirds, then the end), run clockwise on screen: the flat roofs as walkable
// `Top`s left to right, then `Rock` for the cornices, down the walls (which stand past the map's
// bottom, in the harbour far below) and back. Roofs are barely roughened (`rough: 0.1`), the
// containers not at all. Windowed walls stand 28 or 12 px past a multiple of 40 (of 80 for the
// warehouses), so each style's windows (tiled from x = 0 in terrain.svg) fill a facade whole.
// `dress` places decorations into the map's terrain.svg, one rule per slot (`{{name}}`).
//
// B: warehouses at the edges, then a stack of containers eight high, a cold store, and the harbour
// office on each pier head across the slip. A gantry crane spans the slip (scenery, not solid) and
// holds two boxes over it: a floating block, cover from the middle arcs, which flat shots pass
// under and high ones over. Spawns are mirrored about x = 1000.
Land(
    size: (2000, 1100),
    islands: [
        // Warehouse 7: brick, loading doors under a hoist, low at the edge. One spawn (130).
        (
            start: (-50.0, 650.0),
            edges: [
                Top((2.0, 650.0), (54.0, 650.0), (106.0, 650.0)),
                Top((158.0, 650.0), (210.0, 650.0), (262.0, 650.0)),
                Rock((262.0, 653.3), (262.0, 656.7), (262.0, 660.0)),
                Rock((258.7, 660.7), (255.3, 661.3), (252.0, 662.0)),
                Rock((252.0, 821.3), (252.0, 980.7), (252.0, 1140.0)),
                Rock((154.7, 1140.0), (57.3, 1140.0), (-40.0, 1140.0)),
                Rock((-40.0, 980.7), (-40.0, 821.3), (-40.0, 662.0)),
                Rock((-43.3, 661.3), (-46.7, 660.7), (-50.0, 660.0)),
                Rock((-50.0, 656.7), (-50.0, 653.3), (-50.0, 650.0)),
            ],
            rough: 0.1,
        ),
        // The stack: containers eight high on a quay plinth, the highest roof. One spawn (420).
        (
            start: (340.0, 420.0),
            edges: [
                Top((393.3, 420.0), (446.7, 420.0), (500.0, 420.0)),
                Rock((500.0, 660.0), (500.0, 900.0), (500.0, 1140.0)),
                Rock((446.7, 1140.0), (393.3, 1140.0), (340.0, 1140.0)),
                Rock((340.0, 900.0), (340.0, 660.0), (340.0, 420.0)),
            ],
            rough: 0.0,
        ),
        // Cold store: ribbed steel. One spawn (640).
        (
            start: (538.0, 500.0),
            edges: [
                Top((572.0, 500.0), (606.0, 500.0), (640.0, 500.0)),
                Top((674.0, 500.0), (708.0, 500.0), (742.0, 500.0)),
                Rock((742.0, 503.3), (742.0, 506.7), (742.0, 510.0)),
                Rock((738.7, 510.7), (735.3, 511.3), (732.0, 512.0)),
                Rock((732.0, 721.3), (732.0, 930.7), (732.0, 1140.0)),
                Rock((670.7, 1140.0), (609.3, 1140.0), (548.0, 1140.0)),
                Rock((548.0, 930.7), (548.0, 721.3), (548.0, 512.0)),
                Rock((544.7, 511.3), (541.3, 510.7), (538.0, 510.0)),
                Rock((538.0, 506.7), (538.0, 503.3), (538.0, 500.0)),
            ],
            rough: 0.1,
        ),
        // Harbour office on the west pier head, by the slip. One spawn (840).
        (
            start: (778.0, 660.0),
            edges: [
                Top((819.3, 660.0), (860.7, 660.0), (902.0, 660.0)),
                Rock((902.0, 663.3), (902.0, 666.7), (902.0, 670.0)),
                Rock((898.7, 670.7), (895.3, 671.3), (892.0, 672.0)),
