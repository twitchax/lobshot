            (symbol: "area", at: (1580.0, 420.0), scale: 1.60),
        ]),
        // Where its windows go: a style's windows tile its area from the first floor under the roof.
        Place(slot: "officeWin", props: [
            (symbol: "area", at: (640.0, 530.0), scale: 1.60),
            (symbol: "area", at: (1360.0, 530.0), scale: 1.60),
