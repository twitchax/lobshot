                Rock((1500.0, 900.0), (1500.0, 660.0), (1500.0, 420.0)),
            ],
            rough: 0.0,
        ),
        // Warehouse 9: the mirror of Warehouse 7 (spawn 1870).
        (
            start: (1738.0, 650.0),
            edges: [
                Top((1790.0, 650.0), (1842.0, 650.0), (1894.0, 650.0)),
                Top((1946.0, 650.0), (1998.0, 650.0), (2050.0, 650.0)),
                Rock((2050.0, 653.3), (2050.0, 656.7), (2050.0, 660.0)),
                Rock((2046.7, 660.7), (2043.3, 661.3), (2040.0, 662.0)),
                Rock((2040.0, 821.3), (2040.0, 980.7), (2040.0, 1140.0)),
                Rock((1942.7, 1140.0), (1845.3, 1140.0), (1748.0, 1140.0)),
                Rock((1748.0, 980.7), (1748.0, 821.3), (1748.0, 662.0)),
                Rock((1744.7, 661.3), (1741.3, 660.7), (1738.0, 660.0)),
                Rock((1738.0, 656.7), (1738.0, 653.3), (1738.0, 650.0)),
            ],
            rough: 0.1,
        ),
    ],
    dress: [
        Edge(slot: "roofs", along: Top, symbols: ["vent", "vent", "turbine", "hatch", "puddle", "puddle", "gravel", "gravel", "gravel"], every: 46.0, scale: (0.8, 1.1), follow_normal: true, seed: 11),
        Fill(slot: "grime", symbols: ["stain", "stain", "patch", "stainLong"], spacing: 150.0, depth: (60.0, 700.0), scale: (0.8, 1.2), turn: 0.0, seed: 5),
        // Each building's facade colour, the width of its walls.
        Place(slot: "washes", props: [
            (symbol: "washBrick", at: (106.0, 650.0), scale: 2.92),
            (symbol: "washQuay", at: (420.0, 420.0), scale: 1.60),
            (symbol: "washRust", at: (640.0, 500.0), scale: 1.84),
            (symbol: "washTeal", at: (840.0, 660.0), scale: 1.04),
            (symbol: "washSlate", at: (1160.0, 660.0), scale: 1.04),
            (symbol: "washOlive", at: (1360.0, 500.0), scale: 1.84),
            (symbol: "washQuay", at: (1580.0, 420.0), scale: 1.60),
            (symbol: "washOchre", at: (1894.0, 650.0), scale: 2.92),
        ]),
        // What its walls are made of, by the same areas.
        Place(slot: "brickAreas", props: [
            (symbol: "area", at: (106.0, 650.0), scale: 2.92),
            (symbol: "area", at: (1894.0, 650.0), scale: 2.92),
