            (symbol: "box20Red", at: (1540.0, 540.0)),
            (symbol: "box20Blue", at: (1620.0, 540.0)),
            (symbol: "box20Teal", at: (1540.0, 580.0)),
            (symbol: "box20Blue", at: (1620.0, 580.0)),
            (symbol: "box20Orange", at: (1540.0, 620.0)),
            (symbol: "box20Blue", at: (1620.0, 620.0)),
