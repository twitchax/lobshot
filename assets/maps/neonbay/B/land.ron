            edges: [
                Top((981.3, 520.0), (1018.7, 520.0), (1056.0, 520.0)),
                Rock((1056.0, 550.7), (1056.0, 581.3), (1056.0, 612.0)),
                Rock((1018.7, 612.0), (981.3, 612.0), (944.0, 612.0)),
                Rock((944.0, 581.3), (944.0, 550.7), (944.0, 520.0)),
            ],
            rough: 0.0,
        ),
        // Harbour office on the east pier head (spawn 1160).
        (
            start: (1098.0, 660.0),
            edges: [
                Top((1139.3, 660.0), (1180.7, 660.0), (1222.0, 660.0)),
                Rock((1222.0, 663.3), (1222.0, 666.7), (1222.0, 670.0)),
