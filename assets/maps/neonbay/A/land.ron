                Rock((1258.7, 650.7), (1255.3, 651.3), (1252.0, 652.0)),
                Rock((1252.0, 814.7), (1252.0, 977.3), (1252.0, 1140.0)),
                Rock((1204.0, 1140.0), (1156.0, 1140.0), (1108.0, 1140.0)),
