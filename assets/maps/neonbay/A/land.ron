// Neonbay A, "downtown": the land, the one source for both the terrain art and the collision mask.
//
// World pixels, y down. Each building is a closed chain of cubic Béziers (here straight lines: two
// control points at the thirds, then the end), run clockwise on screen: the flat roofs as walkable
// `Top`s left to right, then `Rock` for the cornices, down the walls (which stand past the map's
// bottom, in the street far below) and back. Roofs are tar and gravel, barely roughened
// (`rough: 0.1`). Windowed walls stand 28 or 12 px past a multiple of 40, so each style's windows
// (tiled from x = 0 in terrain.svg) fill a facade whole. `dress` places decorations into the map's
// terrain.svg, one rule per slot (`{{name}}`).
//
// A: towers with stepped crowns at the edges, then a brick hotel, a glass office tower and a
// walk-up a side, and a picture palace on the avenue in the middle. The roofs go tall, low, tall,
// low toward the palace, so the hotels and the walk-ups sit in the lee of the towers: cover from
// flat shots, yet every spawn keeps a lob across the middle for every mobile, at worst after a step
// back. Spawns are mirrored about x = 1000.
Land(
    size: (2000, 1100),
    islands: [
        // Meridian: the tallest tower, at the west edge, its crown stepped back off the map. One
        // spawn (140) on its shoulder.
        (
            start: (-50.0, 360.0),
            edges: [
                Top((-12.7, 360.0), (24.7, 360.0), (62.0, 360.0)),
                Rock((62.0, 363.3), (62.0, 366.7), (62.0, 370.0)),
                Rock((58.7, 370.7), (55.3, 371.3), (52.0, 372.0)),
                Rock((52.0, 394.7), (52.0, 417.3), (52.0, 440.0)),
                Top((108.7, 440.0), (165.3, 440.0), (222.0, 440.0)),
                Rock((222.0, 443.3), (222.0, 446.7), (222.0, 450.0)),
                Rock((218.7, 450.7), (215.3, 451.3), (212.0, 452.0)),
                Rock((212.0, 681.3), (212.0, 910.7), (212.0, 1140.0)),
                Rock((128.0, 1140.0), (44.0, 1140.0), (-40.0, 1140.0)),
                Rock((-40.0, 884.0), (-40.0, 628.0), (-40.0, 372.0)),
                Rock((-43.3, 371.3), (-46.7, 370.7), (-50.0, 370.0)),
                Rock((-50.0, 366.7), (-50.0, 363.3), (-50.0, 360.0)),
            ],
            rough: 0.1,
        ),
        // Hotel Halcyon: brick, a fire escape, a blade sign, low between the towers. One spawn (380).
        (
            start: (258.0, 620.0),
            edges: [
                Top((292.0, 620.0), (326.0, 620.0), (360.0, 620.0)),
                Top((394.0, 620.0), (428.0, 620.0), (462.0, 620.0)),
                Rock((462.0, 623.3), (462.0, 626.7), (462.0, 630.0)),
                Rock((458.7, 630.7), (455.3, 631.3), (452.0, 632.0)),
                Rock((452.0, 801.3), (452.0, 970.7), (452.0, 1140.0)),
                Rock((390.7, 1140.0), (329.3, 1140.0), (268.0, 1140.0)),
                Rock((268.0, 970.7), (268.0, 801.3), (268.0, 632.0)),
                Rock((264.7, 631.3), (261.3, 630.7), (258.0, 630.0)),
                Rock((258.0, 626.7), (258.0, 623.3), (258.0, 620.0)),
