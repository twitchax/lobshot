    dress: [
        Edge(slot: "tufts", along: Top, symbols: ["tuftL", "tuftL", "tuftL", "tuftS", "tuftS", "flower", "flowerY"], every: 12.0, scale: (0.8, 1.25), follow_normal: true, mirror: true, seed: 4),
        Edge(slot: "hangers", along: Under, symbols: ["root", "rootShort", "rootShort", "kelp"], every: 30.0, scale: (0.7, 1.25), mirror: true, seed: 9),
        Edge(slot: "walls", along: Wall, symbols: ["coral"], every: 190.0, scale: (0.8, 1.1), follow_normal: true, mirror: true, seed: 17),
        Fill(
            slot: "stones",
            symbols: ["stoneA", "stoneB", "stoneC", "stoneD", "stoneA", "crack"],
            tints: ["#cf8a5c", "#c27a52", "#d9a070", "#b4704e", "#a98a8e", "#9a7a88"],
            spacing: 50.0,
            depth: (26.0, 600.0),
            scale: (0.6, 1.2),
            turn: 25.0,
            seed: 12,
