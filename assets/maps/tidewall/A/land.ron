        (
            start: (1366.0, 594.0),
            edges: [
                Top((1396.0, 578.0), (1430.0, 566.0), (1470.0, 566.0)),
                Top((1510.0, 566.0), (1540.0, 576.0), (1580.0, 588.0)),
