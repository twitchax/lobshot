                Rock((146.0, 812.0), (108.0, 802.0), (84.0, 772.0)),
                Rock((66.0, 750.0), (58.0, 722.0), (46.0, 704.0)),
                Rock((30.0, 682.0), (12.0, 656.0), (24.0, 624.0)),
