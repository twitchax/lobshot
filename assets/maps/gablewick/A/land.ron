                Top((650.7, 465.0), (691.3, 473.0), (732.0, 481.0)),
                Rock((732.0, 483.3), (732.0, 485.7), (732.0, 488.0)),
                Rock((728.0, 488.7), (724.0, 489.3), (720.0, 490.0)),
                Rock((720.0, 673.3), (720.0, 856.7), (720.0, 1040.0)),
                Rock((576.7, 1040.0), (433.3, 1040.0), (290.0, 1040.0)),
