// Gablewick B: the land, the one source for both the terrain art and the collision mask.
//
// World pixels, y down. Each block is a closed chain of cubic Béziers (here straight lines: two
// control points at the thirds, then the end), run clockwise on screen: the roofs as walkable `Top`s
// left to right, then `Rock` down the walls (which stand past the map's bottom, in the canal) and
// back. A taller house's eave overhangs a lower neighbour's roof. Roofs are barely roughened
// (`rough: 0.2`): tiles, not rock. `dress` places decorations into the map's terrain.svg, one rule
// per slot (`{{name}}`); windows and doors are placed by hand, house by house, since a scatter would
// not line them up.
//
// B, "valley": tall houses on the edges step down toward a broken canal bridge in the middle, whose
// missing span (x 915 to 985) is a pit to the water. Two turrets at about a third and two thirds are
// the cover. Spawns are mirrored about x = 950 (125, 360, 590, 840 and 1060, 1310, 1540, 1775).
Land(
    size: (1900, 1000),
    islands: [
        // Guild Hall and the Cooper's: the tall west houses, stepping down (spawns 125, 360).
        (
            start: (-42.0, 377.0),
            edges: [
                Top((8.7, 371.7), (59.3, 366.3), (110.0, 361.0)),
                Top((160.7, 366.3), (211.3, 371.7), (262.0, 377.0)),
                Rock((262.0, 379.3), (262.0, 381.7), (262.0, 384.0)),
                Rock((258.0, 384.7), (254.0, 385.3), (250.0, 386.0)),
                Rock((250.0, 417.1), (250.0, 448.2), (250.0, 479.2)),
                Top((286.7, 473.8), (323.3, 468.4), (360.0, 463.0)),
                Top((400.7, 469.0), (441.3, 475.0), (482.0, 481.0)),
                Rock((482.0, 483.3), (482.0, 485.7), (482.0, 488.0)),
                Rock((478.0, 488.7), (474.0, 489.3), (470.0, 490.0)),
                Rock((470.0, 673.3), (470.0, 856.7), (470.0, 1040.0)),
                Rock((303.3, 1040.0), (136.7, 1040.0), (-30.0, 1040.0)),
                Rock((-30.0, 822.0), (-30.0, 604.0), (-30.0, 386.0)),
                Rock((-34.0, 385.3), (-38.0, 384.7), (-42.0, 384.0)),
                Rock((-42.0, 381.7), (-42.0, 379.3), (-42.0, 377.0)),
            ],
            rough: 0.2,
        ),
        // The Weaver's, with a turret on its east end as cover (spawn 590).
        (
            start: (498.0, 585.0),
            edges: [
                Top((532.0, 580.3), (566.0, 575.7), (600.0, 571.0)),
                Top((630.0, 575.1), (660.0, 579.2), (690.0, 583.4)),
