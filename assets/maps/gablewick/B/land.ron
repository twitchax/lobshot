    dress: [
        Edge(slot: "ivy", along: Wall, symbols: ["ivy", "ivy", "ivySmall"], every: 120.0, scale: (0.8, 1.2), follow_normal: true, mirror: true, seed: 7),
        Edge(slot: "roofs", along: Top, symbols: ["moss", "moss", "mossSmall", "pigeonL", "pigeonR", "roofFlower"], every: 70.0, scale: (0.8, 1.1), follow_normal: true, seed: 13),
