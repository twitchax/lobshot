// Sparkhorn: a rhino-beetle mech that rolls on wheels at the ends of its legs, with a tesla-coil
// horn for a cannon. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact under the wheels, +x =
// facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so
// `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each part with
// its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::sparkhorn; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Sparkhorn",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The wheels sit over the legs, hiding where each leg meets its axle.
        (id: "body",        file: "body.svg",   at: (0.0, 0.0),    z: 2),
        (id: "wheel_rear",  file: "wheel.svg",  at: (-23.0, -7.0), z: 3, spin: true),
        (id: "wheel_mid",   file: "wheel.svg",  at: (0.0, -7.0),   z: 3, spin: true),
        (id: "wheel_front", file: "wheel.svg",  at: (23.0, -7.0),  z: 3, spin: true),
        (id: "cannon",      file: "cannon.svg", at: (25.0, -23.0), z: 4, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the discharge ball, one
        // barrel length (sim::tuning) from the pivot. The client hangs the muzzle flash here.
        muzzle: (27.6, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-10.0, -52.0), z: 5),
)
