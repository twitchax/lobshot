// Sparkhorn: a placeholder, Coilback's rig until Sparkhorn's own drawing lands.
//
// World pixels. Body frame: origin = the center of the tread's ground contact, +x = facing, +y =
// down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so `at` is where
// that pivot lands in the body frame, and `cargo xtask art` renders each part with its pivot at
// the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::sparkhorn; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Sparkhorn",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        (id: "tread",       file: "tread.svg",       at: (0.0, 0.0),    z: 0),
        (id: "wheel_rear",  file: "wheel_big.svg",   at: (-17.5, -9.5), z: 1, spin: true),
        (id: "wheel_mid",   file: "wheel_small.svg", at: (0.0, -7.0),   z: 1, spin: true),
        (id: "wheel_front", file: "wheel_big.svg",   at: (17.5, -9.5),  z: 1, spin: true),
        (id: "body",        file: "body.svg",        at: (0.0, 0.0),    z: 2),
        (id: "cannon",      file: "cannon.svg",      at: (7.0, -48.0),  z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the bell's mouth, one
        // barrel length (sim::tuning) from the pivot. The client hangs the muzzle flash here.
        muzzle: (28.8, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-12.0, -56.0), z: 4),
)
