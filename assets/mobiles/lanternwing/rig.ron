// Lanternwing: a moth mech that walks on six jointed legs, its wings glowing as its shield and a
// lantern for a cannon. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the feet, +x =
// facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so
// `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each part with
// its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::lanternwing; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Lanternwing",
    parts: [
        // Drawn in z order, lowest first. aim: turns with the cannon. It walks, so nothing spins.
        (id: "body",   file: "body.svg",   at: (0.0, 0.0),    z: 2),
        (id: "cannon", file: "cannon.svg", at: (12.0, -43.0), z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the lantern's lens, one
        // barrel length (sim::tuning) from the pivot. The client hangs the muzzle flash here.
        muzzle: (27.6, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-4.0, -37.0), z: 4),
)
