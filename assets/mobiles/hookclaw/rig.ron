// Hookclaw: a hermit-crab mech living in a glazed jar on its side, flinging crescent boomerangs
// from its big claw. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the legs, +x =
// facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so
// `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each part with
// its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::hookclaw; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Hookclaw",
    parts: [
        // Drawn in z order, lowest first. aim: turns with the cannon. It walks, so nothing spins.
        (id: "body",   file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The big claw: its shoulder sits in the jar's mouth, so it reaches straight up at 90
        // degrees clear of the jar, ahead of the rider.
        (id: "cannon", file: "cannon.svg", at: (15.0, -40.0), z: 3, aim: true),
        // The jar's lip, over the claw's shoulder: the claw comes out of the jar.
        (id: "lip",    file: "lip.svg",    at: (14.0, -29.0), z: 4),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the boomerang in the
        // claw, one barrel length (sim::tuning) from the pivot.
        muzzle: (31.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-12.0, -52.0), z: 5),
)
