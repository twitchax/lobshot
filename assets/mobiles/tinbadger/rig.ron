// Tinbadger: a badger tinker in brass goggles pushing a crate cart heaped with wind-up tin beetles,
// a tin launcher on the crate's front corner. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the badger's feet
// and the cart's front wheel, +x = facing, +y = down; facing left mirrors x. Every part SVG puts its
// pivot at its own origin, so `at` is where that pivot lands in the body frame, and `cargo xtask
// art` renders each part with its pivot at the image's center (lobshot_assets::ART_SCALE pixels
// per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::tinbadger; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Tinbadger",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The cart's wheels sit under its crate.
        (id: "wheel_rear",  file: "wheel.svg",  at: (6.0, -8.0),   z: 1, spin: true),
        (id: "wheel_front", file: "wheel.svg",  at: (28.0, -8.0),  z: 1, spin: true),
        (id: "body",        file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The launcher hinges on the crate's front corner, over the heap of beetles.
        (id: "cannon",      file: "cannon.svg", at: (30.0, -38.0), z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the beetle in the bell,
        // one barrel length (sim::tuning) from the pivot.
        muzzle: (24.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat. The rider sits in the crate
    // among the beetles.
    rider_socket: (at: (14.0, -36.0), z: 4),
    // What its shots look like: the cogs, the beetles (in flight and on the map as mines), and the
    // big one.
    sprites: [
        (id: "s1",   file: "cog.svg"),
        (id: "s2",   file: "mine.svg"),
        (id: "mine", file: "mine.svg"),
        (id: "ss",   file: "beetle.svg"),
    ],
)
