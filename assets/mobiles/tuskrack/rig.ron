// Tuskrack: a walrus riding a tank-sled, a snow track under its tail and a ski at its nose, with
// a rack of fireworks rockets strapped to its back for a cannon. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the track and the
// ski, +x = facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own
// origin, so `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each
// part with its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::tuskrack; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Tuskrack",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The track's road wheels ride on the belt, under the sled's tub.
        (id: "tread",       file: "tread.svg",  at: (0.0, 0.0),    z: 0),
        (id: "wheel_rear",  file: "wheel.svg",  at: (-26.5, -7.9), z: 1, spin: true),
        (id: "wheel_mid",   file: "wheel.svg",  at: (-13.6, -7.9), z: 1, spin: true),
        (id: "wheel_front", file: "wheel.svg",  at: (-0.7, -7.9),  z: 1, spin: true),
        (id: "body",        file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The rack swivels on a post on the walrus's back, ahead of the rider's saddle.
        (id: "cannon",      file: "cannon.svg", at: (0.0, -52.0),  z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the bottom rocket's
        // nose, one barrel length (sim::tuning) from the pivot. The client hangs the muzzle flash
        // here.
        muzzle: (28.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-24.0, -39.0), z: 4),
)
