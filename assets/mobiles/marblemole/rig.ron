// Marblemole: a mole in a miner's helmet riding a wooden mine cart, bowling static-charged
// marbles down a chute. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the wheels, +x =
// facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so
// `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each part with
// its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::marblemole; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Marblemole",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The wheels sit under the cart, its wall over their tops.
        (id: "wheel_rear",  file: "wheel.svg",  at: (-15.0, -8.0), z: 1, spin: true),
        (id: "wheel_front", file: "wheel.svg",  at: (13.0, -8.0),  z: 1, spin: true),
        (id: "body",        file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The chute hinges on the cart's front corner, ahead of the mole's helmet.
        (id: "cannon",      file: "cannon.svg", at: (28.0, -39.0), z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the marble at the
        // chute's lip, one barrel length (sim::tuning) from the pivot.
        muzzle: (28.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-14.0, -40.0), z: 4),
)
