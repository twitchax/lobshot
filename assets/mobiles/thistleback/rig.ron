// Thistleback: a hedgehog gardener in a straw hat pushing a wheelbarrow of cabbages, a spring
// catapult on its front rim. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the hedgehog's feet
// and the barrow wheel, +x = facing, +y = down; facing left mirrors x. Every part SVG puts its
// pivot at its own origin, so `at` is where that pivot lands in the body frame, and `cargo xtask
// art` renders each part with its pivot at the image's center (lobshot_assets::ART_SCALE pixels
// per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::thistleback; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Thistleback",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The wheel sits under the barrow, its fork and axle cap over it.
        (id: "wheel",  file: "wheel.svg",  at: (26.0, -10.0), z: 1, spin: true),
        (id: "body",   file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The catapult hinges on the barrow's front rim, ahead of its load.
        (id: "cannon", file: "cannon.svg", at: (33.0, -39.0), z: 3, aim: true),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the cabbage in the
        // cup, one barrel length (sim::tuning) from the pivot.
        muzzle: (28.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat. The rider rides in the
    // barrow, behind its load, hands on the release lever.
    rider_socket: (at: (10.0, -37.0), z: 4),
)
