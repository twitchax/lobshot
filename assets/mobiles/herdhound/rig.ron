// Herdhound: a shaggy sheepdog mech on a pull-toy chassis, lobbing woolly missiles from its jaws
// and herding them home with the whistle on its collar. Its cutout rig: the art only.
//
// World pixels. Body frame: origin = the center of the ground contact between the wheels, +x =
// facing, +y = down; facing left mirrors x. Every part SVG puts its pivot at its own origin, so
// `at` is where that pivot lands in the body frame, and `cargo xtask art` renders each part with
// its pivot at the image's center (lobshot_assets::ART_SCALE pixels per world pixel).
//
// Gameplay geometry (hitbox, ground probes, aim range, cannon pivot and barrel length) lives in
// sim::tuning::herdhound; `cargo xtask art` refuses a rig whose cannon disagrees with it.
MobileRig(
    name: "Herdhound",
    parts: [
        // Drawn in z order, lowest first. spin: rolls as it moves; aim: turns with the cannon.
        // The wheels sit under the coat's fringe.
        (id: "wheel_rear",  file: "wheel.svg",  at: (-19.0, -8.0), z: 1, spin: true),
        (id: "wheel_front", file: "wheel.svg",  at: (17.0, -8.0),  z: 1, spin: true),
        (id: "body",        file: "body.svg",   at: (0.0, 0.0),    z: 2),
        // The head lifts on its neck joint at the front of the coat.
        (id: "cannon",      file: "cannon.svg", at: (20.0, -40.0), z: 3, aim: true),
        // The collar rings the neck just behind the joint, over the head's root: the head turns
        // inside it.
        (id: "collar",      file: "collar.svg", at: (20.0, -40.0), z: 4),
    ],
    cannon: (
        part: "cannon",
        // Where shots leave, in the cannon's frame at aim 0 (pointing +x): the woolly missile in
        // the jaws, one barrel length (sim::tuning) from the pivot.
        muzzle: (27.0, 0.0),
    ),
    // Riders are cosmetic and swappable; a rider's origin is its seat.
    rider_socket: (at: (-12.0, -49.0), z: 5),
)
